rule fetch_zenodo_metadata:
    output:
        workbook="data/raw/zenodo/v4_ICB_datasets.xlsx",
        files="data/raw/zenodo/zenodo_14511579_files.tsv"
    shell:
        "python scripts/00_fetch_zenodo_metadata.py --record 14511579 --out-dir data/raw/zenodo"


rule build_icb_manifest:
    input:
        workbook="data/raw/zenodo/v4_ICB_datasets.xlsx"
    output:
        discovery="data/manifests/icb_sc_discovery_datasets.tsv",
        files="data/manifests/icb_sc_discovery_files.tsv",
        treatment="data/manifests/icb_sc_treatment_information.tsv"
    shell:
        "python scripts/00_build_icb_manifest.py --workbook {input.workbook} --out-dir data/manifests"


