rule extract_nmf_states:
    output:
        activity="results/tables/nmf_states/nmf_state_activity.tsv",
        markers="results/tables/nmf_states/nmf_state_markers.tsv",
        signatures="results/tables/nmf_states/nmf_state_signatures.yml"
    shell:
        "python scripts/05_extract_nmf_states.py --input-dir data/raw/zenodo/malignant_pseudobulk --out-dir results/tables/nmf_states --k 7 --scan-k 4-8 --n-top-genes 1000 --max-iter 500 --scan-max-iter 250"


rule score_zenodo_pseudobulk:
